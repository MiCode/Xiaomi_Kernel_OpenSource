cc_binary(
    name = "unifdef",
    srcs = ["scripts/unifdef.c"],
    copts = [],
)

genrule(
    name = "gen-headers_install.sh",
    srcs = ["scripts/headers_install.sh"],
    outs = ["generated_headers_install.sh"],
    cmd = "sed 's+scripts/unifdef+$${LOC_UNIFDEF:-$$(dirname $$0)/unifdef}+g' $(SRCS) > $(OUTS)",
    tools = [":unifdef"],
)

sh_binary(
    name = "headers_install.sh",
    srcs = [":gen-headers_install.sh"],
    deps = [":unifdef"],
)

wireless_certs_cmd = """
    (echo '#include "reg.h"'; \
    echo 'const u8 shipped_regdb_certs[] = {'; \
    echo | cat - $(SRCS) ; \
    echo '};'; \
    echo 'unsigned int shipped_regdb_certs_len = sizeof(shipped_regdb_certs);'; \
    ) > $@
"""

hermetic_genrule(
    name = "net/wireless/shipped-certs",
    srcs = glob(
        ["net/wireless/certs/*.hex"],
        allow_empty = True,
    ),
    outs = ["net/wireless/shipped-certs.c"],
    cmd = """
        (echo '#include "reg.h"'; \
        echo 'const u8 shipped_regdb_certs[] = {'; \
        echo | cat - $(SRCS) ; \
        echo '};'; \
        echo 'unsigned int shipped_regdb_certs_len = sizeof(shipped_regdb_certs);'; \
        ) > $@
        """,
)

filegroup(
    name = "soc_repo_sources",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "dt_bindings_headers",
    srcs = glob([
        "include/dt-bindings/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)

ddk_headers(
    name = "dt_bindings",
    hdrs = [
        # do not sort
        ":dt_bindings_headers",
    ],
    includes = [
        "include",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "additional_msm_headers_aarch64_globs",
    srcs = glob(
        [
            "arch/arm64/include/**/*.h",
            "include/**/*.h",
            "arch/arm/include/**/*.h",
            "include/uapi/**",
        ],
        allow_empty = True,
    ),
    visibility = ["//visibility:private"],
)

ddk_headers(
    name = "additional_msm_headers",
    hdrs = [
        # do not sort
        ":additional_msm_headers_aarch64_globs",
    ],
    linux_includes = [
        "arch/arm64/include",
        "arch/arm64/include/uapi",
        "include",
        "include/uapi",
    ],
    visibility = ["//visibility:public"],
)

ddk_headers(
    name = "all_headers",
    hdrs = [
        # do not sort
        ":additional_msm_headers",
        "//common:all_headers",
        ":unsafe_headers_qcom_group_headers",
    ],
    visibility = ["//visibility:public"],
)

ddk_uapi_headers(
    name = "msm_uapi_headers",
    srcs = glob(["include/uapi/**/*.h"]),
    out = "msm_uapi_headers.tar.gz",
    kernel_build = ":msm_kernel_build",
    visibility = ["//visibility:public"],
)

ddk_uapi_headers_cc_library(
    name = "ddk_uapi_headers",
    header_archive = ":msm_uapi_headers",
)

hermetic_genrule(
    name = "kconfig.msm.generated",
    srcs = glob(["**/Kconfig*"]),
    outs = ["Kconfig.ext"],
    cmd = "KCONFIG_EXT_PREFIX=soc-repo/ $(location flatten_kconfig.sh) $(location Kconfig.msm) >$@",
    tools = ["flatten_kconfig.sh"],
)

ddk_headers(
    name = "unsafe_headers_qcom_group_headers",
    hdrs = [
    # do not sort
    ":unsafe_headers_qcom_group"
    ],
    visibility = ["//visibility:public"],
)

