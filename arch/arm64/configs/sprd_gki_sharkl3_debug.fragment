CONFIG_CONSOLE_LOGLEVEL_DEFAULT=1
CONFIG_DYNAMIC_FTRACE=y
CONFIG_DYNAMIC_FTRACE_WITH_REGS=y
# CONFIG_ENABLE_SPRD_DEEP_SLEEP_TRACING is not set
CONFIG_ENABLE_SPRD_IO_TRACING=y
# CONFIG_FAILSLAB is not set
# CONFIG_FAIL_FUNCTION is not set
# CONFIG_FAIL_FUTEX is not set
# CONFIG_FAIL_IO_TIMEOUT is not set
# CONFIG_FAIL_MAKE_REQUEST is not set
CONFIG_FAIL_MMC_REQUEST=y
# CONFIG_FAIL_PAGE_ALLOC is not set
CONFIG_FAULT_INJECTION=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
# CONFIG_FAULT_INJECTION_STACKTRACE_FILTER is not set
# CONFIG_FAULT_INJECTION_USERCOPY is not set
CONFIG_FTRACE_MCOUNT_RECORD=y
CONFIG_FTRACE_MCOUNT_USE_PATCHABLE_FUNCTION_ENTRY=y
# CONFIG_FTRACE_RECORD_RECURSION is not set
# CONFIG_FTRACE_STARTUP_TEST is not set
CONFIG_FUNCTION_GRAPH_TRACER=y
# CONFIG_FUNCTION_PROFILER is not set
CONFIG_FUNCTION_TRACER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y
CONFIG_GENERIC_TRACER=y
CONFIG_IRQSOFF_TRACER=y
CONFIG_IRQSOFF_WARN=y
CONFIG_IRQ_CONSUMPTION_MONITOR=y
CONFIG_IRQ_MONITOR=y
# CONFIG_KPROBE_EVENTS_ON_NOTRACE is not set
CONFIG_PREEMPTIRQ_TRACEPOINTS=y
CONFIG_PREEMPT_TRACER=y
CONFIG_PREEMPT_WARN=y
# CONFIG_PSTORE_FTRACE is not set
CONFIG_RING_BUFFER_ALLOW_SWAP=y
# CONFIG_SCSI_UFS_FAULT_INJECTION is not set
CONFIG_SHOW_UREGS_WITH_PHYSICAL=y
# CONFIG_SPRD_APB_BUSMONITOR is not set
CONFIG_SPRD_APB_PROT=m
CONFIG_SPRD_BUSMONITOR=m
CONFIG_SPRD_CMA_DEBUG=y
CONFIG_SPRD_DATA_COLLECTOR=y
CONFIG_SPRD_DEBUG=y
CONFIG_SPRD_DJTAG=m
CONFIG_SPRD_DJTAG_CORE=m
CONFIG_SPRD_DMC_MPU=m
CONFIG_SPRD_DMC_MPU_CORE=y
# CONFIG_SPRD_DMC_MPU_R3P0 is not set
# CONFIG_SPRD_DMC_MPU_R4P0 is not set
CONFIG_SPRD_HANG_TRIGGER=y
CONFIG_SPRD_LOOK_AT=m
CONFIG_SPRD_MEM_OVERLAY_CHECK=y
CONFIG_SPRD_PAST_RECORD=y
CONFIG_SPRD_PMIC_SMPL=m
CONFIG_SPRD_PTM=m
# CONFIG_SPRD_PTM_DIFF_R6P1 is not set
CONFIG_SPRD_SHOW_RESERVED_MEM=y
# CONFIG_SPRD_UNDEF_HOOK is not set
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_TASKS_RUDE_RCU=y
CONFIG_TRACER_MAX_TRACE=y
CONFIG_TRACER_SNAPSHOT=y
CONFIG_TRACER_SNAPSHOT_PER_CPU_SWAP=y
CONFIG_TRACE_IRQFLAGS=y
CONFIG_TRACE_IRQFLAGS_NMI=y
CONFIG_TRACE_PREEMPT_TOGGLE=y
# CONFIG_UNISOC_CACHEDUMP is not set
CONFIG_UNISOC_EMEM_DMA_BUF=y
CONFIG_UNISOC_FIX_FREQ=y
CONFIG_UNISOC_MINIDUMP_FTRACE=y
CONFIG_UNISOC_MINIDUMP_FTRACE_SIZE_KB=256
# CONFIG_UNISOC_REG_TRACE_MONITOR is not set
CONFIG_UNISOC_RT_TIMEOUT_DETECT_MS=800
# CONFIG_UNISOC_SCHED_DEBUG_ATOMIC is not set
CONFIG_UNISOC_SIGNAL_DEBUG=y
# CONFIG_WCN_UTILS is not set
